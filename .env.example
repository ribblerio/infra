# Postgres root password (single shared DB)
POSTGRES_PASSWORD=changeme

# Anthropic API key for the AI agent
ANTHROPIC_API_KEY=sk-ant-replace

# Shared HS256 secret (32+ bytes). Both control-panel and core-module use this.
JWT_SECRET=replace-with-32-byte-random-secret

# AES-GCM key for encrypting OAuth tokens (32+ bytes base64-able)
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Better-Auth signing secret (32+ bytes)
BETTER_AUTH_SECRET=replace-with-random-32-bytes

# Public URL the browser hits (Cloudflare Tunnel hostname or localhost during dev)
PUBLIC_URL=https://ribbler.example.com
